rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Primitives
    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_\\-]{1,128}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return request.auth != null && (
        request.auth.token.get('email_verified', false) == true ||
        request.auth.token.get('telegram_verified', false) == true
      );
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    // Strictly anonymized RBAC: no personal email hardcoded in rules.
    // Verifies admin status only via custom claims (admin == true) or /admins/{uid} document.
    function isAdmin() {
      return isVerified() && (
        request.auth.token.get('admin', false) == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Strict ISO-8601 or Firestore Timestamp validation (low CEL footprint; .matches fails closed on non-strings)
    function isDate(v) {
      return v is timestamp ||
        v.matches('^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,9})?(Z|[+\\-](0\\d|1\\d|2[0-3]):[0-5]\\d)$');
    }

    function isFreshTs(v) {
      return (v is timestamp && v == request.time) ||
        v.matches('^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,9})?(Z|[+\\-](0\\d|1\\d|2[0-3]):[0-5]\\d)$');
    }

    function isIntRange(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    function isCents(v) {
      return v is int && v >= 0 && v <= 100000000;
    }

    function isPosCents(v) {
      return v is int && v >= 1 && v <= 100000000;
    }

    function isSignedCents(v) {
      return v is int && v >= -100000000 && v <= 100000000;
    }

    function isPosInt(v) {
      return v is int && v > 0;
    }

    function isPollAttempts(v) {
      return v is int && v >= 0 && v <= 10000;
    }

    function isFulfillAttempts(v) {
      return v is int && v >= 0 && v <= 10;
    }

    function isKeyList(v) {
      return v is list && v.size() <= 10 && (v.size() == 0 || v[0] is string);
    }

    function isValidNotificationState(v) {
      return [v.status, v.eventId].join('\n').matches('^(pending|sending|sent|partial_sent|no_recipients|delivery_uncertain)\\n.{1,128}$') &&
        v.attemptCount is int && v.attemptCount >= 0 && v.attemptCount <= 1000;
    }

    function isValidPollLease(v) {
      return v.keys().hasOnly(['leaseOwner', 'operationId', 'leaseUntil', 'acquiredAt']) &&
        [v.leaseOwner, v.operationId].join('\n').matches('^.{1,128}\\n.{1,128}$') &&
        isDate(v.leaseUntil) &&
        isDate(v.acquiredAt);
    }

    // Entity Blueprints synchronized with src/types.ts
    function isValidUser(d, userId) {
      return d.keys().hasAll(['userId', 'telegramId', 'firstName', 'isBlocked', 'totalOrders', 'totalSpentStars', 'createdAt', 'updatedAt']) &&
        d.keys().hasOnly([
          'userId',
          'telegramId',
          'username',
          'firstName',
          'lastName',
          'languageCode',
          'isBlocked',
          'totalOrders',
          'balanceUsdCents',
          'totalSpentUsdCents',
          'totalSpentStars',
          'balance',
          'createdAt',
          'updatedAt'
        ]) &&
        d.userId == userId && d.userId.matches('^[a-zA-Z0-9_\\-]{1,64}$') &&
        d.telegramId is int && d.telegramId > 0 &&
        d.get('username', '').matches('^.{0,64}$') &&
        d.firstName.matches('^.{1,128}$') &&
        d.get('lastName', '').matches('^.{0,128}$') &&
        d.get('languageCode', '').matches('^.{0,16}$') &&
        d.isBlocked is bool &&
        isIntRange(d.totalOrders, 0, 10000000) &&
        isIntRange(d.get('balanceUsdCents', 0), 0, 1000000000) &&
        isIntRange(d.get('totalSpentUsdCents', 0), 0, 1000000000) &&
        d.totalSpentStars is number && d.totalSpentStars >= 0 && d.totalSpentStars <= 1000000000 &&
        d.get('balance', 0) is number && d.get('balance', 0) >= 0 && d.get('balance', 0) <= 1000000000 &&
        isDate(d.createdAt) &&
        isDate(d.updatedAt);
    }

    function isValidProduct(d, productId) {
      return d.keys().hasAll(['id', 'name', 'category', 'description', 'price', 'currency', 'imageUrl', 'isActive', 'fulfillmentType', 'createdAt', 'updatedAt']) &&
        d.keys().hasOnly([
          'id',
          'name',
          'category',
          'description',
          'priceUsdCents',
          'unitPriceUsdCents',
          'price',
          'currency',
          'minQuantity',
          'maxQuantity',
          'durationMonths',
          'imageUrl',
          'isActive',
          'fulfillmentType',
          'keyGeneratorAlgorithm',
          'createdAt',
          'updatedAt'
        ]) &&
        d.id == productId && d.id.matches('^[a-zA-Z0-9_\\-]{1,64}$') &&
        d.name.matches('^.{1,120}$') &&
        d.category in ['stars', 'premium', 'gifts'] &&
        d.description.matches('(?s)^.{1,1000}$') &&
        d.price is number && d.price > 0 && d.price <= 10000000 &&
        isIntRange(d.get('priceUsdCents', 1), 1, 10000000) &&
        isIntRange(d.get('unitPriceUsdCents', 1), 1, 1000000) &&
        d.currency in ['USD', 'XTR'] &&
        isIntRange(d.get('minQuantity', 1), 1, 100000) &&
        isIntRange(d.get('maxQuantity', 1), 1, 100000) &&
        d.get('durationMonths', 3) in [3, 6, 12] &&
        d.imageUrl.matches('^.{0,500}$') &&
        d.isActive is bool &&
        d.fulfillmentType in ['manual', 'provider_adapter', 'mystars'] &&
        d.get('keyGeneratorAlgorithm', 'none') in ['none', 'stars_promo_v1', 'gift_voucher_v1'] &&
        isDate(d.createdAt) &&
        isDate(d.updatedAt);
    }

    // Order Validators (uses Map.get + List.join single-pass RE2 for 100% strict validation under 1000 CEL limit)
    function isValidBuyerOrderCreate(d, orderId) {
      return d.orderId == orderId &&
        d.keys().hasOnly([
          'orderId', 'userId', 'userTelegramId', 'username', 'recipientUsername',
          'productId', 'productName', 'category', 'quantity', 'durationMonths',
          'unitPriceUsdCents', 'totalPriceUsdCents', 'totalPrice', 'currency',
          'paymentMethod', 'paymentStatus', 'fulfillmentStatus',
          'fulfillmentAttempts', 'needsManualReconciliation', 'createdAt', 'updatedAt'
        ]) &&
        [
          d.orderId,
          d.userId,
          d.productId,
          d.productName,
          d.category,
          d.currency,
          d.get('username', ''),
          d.get('recipientUsername', 'a'),
          d.get('paymentMethod', 'cryptobot')
        ].join('\n').matches('^[a-zA-Z0-9_\\-]{1,64}\\n[a-zA-Z0-9_\\-]{1,64}\\n[a-zA-Z0-9_\\-]{1,64}\\n.{1,120}\\n(stars|premium|gifts)\\n(USD|XTR)\\n.{0,64}\\n.{1,64}\\n(cryptobot|xrocket|balance|internal_balance|stars|telegram_stars)$') &&
        d.userTelegramId is int && d.userTelegramId > 0 &&
        d.quantity is int && d.quantity >= 1 && d.quantity <= 100000 &&
        d.totalPrice is number && d.totalPrice > 0 && d.totalPrice <= 100000000 &&
        d.get('durationMonths', 3) in [3, 6, 12] &&
        isPosCents(d.get('unitPriceUsdCents', 1)) &&
        isPosCents(d.get('totalPriceUsdCents', 1)) &&
        d.paymentStatus == 'pending' &&
        d.fulfillmentStatus == 'pending' &&
        d.get('needsManualReconciliation', false) == false &&
        d.get('fulfillmentAttempts', 0) == 0;
    }

    function isBuyerProductValid(productData, d) {
      return productData.isActive == true &&
        productData.price * d.quantity == d.totalPrice &&
        d.get('totalPriceUsdCents', d.totalPrice) == d.totalPrice;
    }

    function isValidOrderStrings(d) {
      return [
          d.orderId,
          d.userId,
          d.productId,
          d.productName,
          d.category,
          d.currency,
          d.paymentStatus,
          d.fulfillmentStatus,
          d.get('paymentMethod', 'cryptobot'),
          d.get('fulfillmentProvider', 'mystars'),
          d.get('mystarsCurrency', 'usdt_ton'),
          d.get('refundState', 'refunded')
        ].join('\n').matches('^[a-zA-Z0-9_\\-]{1,64}\\n[a-zA-Z0-9_\\-]{1,64}\\n[a-zA-Z0-9_\\-]{1,64}\\n.{1,120}\\n(stars|premium|gifts)\\n(USD|XTR)\\n(pending|paid|processing|completed|cancelled|refunded|failed)\\n(pending|paid|processing|completed|cancelled|refunded|failed)\\n(cryptobot|xrocket|balance|internal_balance|stars|telegram_stars)\\n(mystars|manual|fragment)\\n(usdt_ton|ton)\\n(refund_in_progress|telegram_refund_succeeded_pending_commit|refund_failed_needs_reconciliation|refunded)$') &&
        [
          d.get('activePaymentId', 'a'),
          d.get('externalInvoiceId', 'a'),
          d.get('balancePaymentId', 'a'),
          d.get('telegramPaymentChargeId', 'a'),
          d.get('mystarsOrderId', 'a'),
          d.get('mystarsPayToAddress', 'a'),
          d.get('fulfillmentIdempotencyKey', 'a'),
          d.get('refundLockToken', 'a')
        ].join('\n').matches('^.{1,128}(\\n.{1,128}){7}$') &&
        [
          d.get('username', ''),
          d.get('recipientUsername', 'a'),
          d.get('mystarsOrderStatus', 'a'),
          d.get('providerPaymentChargeId', ''),
          d.get('mystarsUnknownStatusSeen', ''),
          d.get('mystarsPaymentMemo', ''),
          d.get('mystarsPurchaseTx', ''),
          d.get('mystarsPaymentTx', ''),
          d.get('mystarsReversalTx', ''),
          d.get('externalExecutionReference', '')
        ].join('\n').matches('^.{0,64}\\n.{1,64}\\n.{1,64}\\n.{0,128}\\n.{0,128}(\\n.{0,256}){5}$') &&
        [
          d.get('mystarsWholesaleCostUsdt', '0'),
          d.get('tonNetworkFeeTon', '0'),
          d.get('mystarsPaymentAmountUsdt', '0')
        ].join('\n').matches('^[0-9]{1,45}(\\.[0-9]{1,18})?(\\n[0-9]{1,45}(\\.[0-9]{1,18})?){2}$') &&
        d.get('mystarsFailureReason', '').matches('(?s)^.{0,500}$') &&
        d.get('mystarsLastPollError', '').matches('(?s)^.{0,500}$') &&
        d.get('fulfillmentNote', '').matches('(?s)^.{0,500}$') &&
        d.get('fulfillmentLastError', '').matches('(?s)^.{0,500}$') &&
        d.get('refundLastError', '').matches('(?s)^.{0,500}$');
    }

    function isValidOrderNumbersAndDates(d, ts) {
      return d.userTelegramId is int && d.userTelegramId > 0 &&
        d.quantity is int && d.quantity >= 1 && d.quantity <= 100000 &&
        d.totalPrice is number && d.totalPrice > 0 && d.totalPrice <= 100000000 &&
        d.get('durationMonths', 3) in [3, 6, 12] &&
        isPosCents(d.get('unitPriceUsdCents', 1)) &&
        isPosCents(d.get('totalPriceUsdCents', 1)) &&
        isCents(d.get('grossRevenueUsdCents', 0)) &&
        isCents(d.get('providerFeeUsdCents', 0)) &&
        isCents(d.get('mystarsCostUsdCents', 0)) &&
        isCents(d.get('tonNetworkFeeUsdCents', 0)) &&
        isSignedCents(d.get('netProfitUsdCents', 0)) &&
        isPollAttempts(d.get('mystarsPollAttempts', 0)) &&
        isFulfillAttempts(d.get('fulfillmentAttempts', 0)) &&
        isPosInt(d.get('completedByAdminId', 1)) &&
        d.get('balanceRefunded', false) is bool &&
        d.get('mystarsCreateInFlight', false) is bool &&
        d.get('needsManualReconciliation', false) is bool &&
        d.get('awaitingKeyStock', false) is bool &&
        d.get('refundStatsAdjusted', false) is bool &&
        isKeyList(d.get('assignedKeyIds', [])) &&
        isKeyList(d.get('deliveredKeyValues', [])) &&
        (!('mystarsPollLease' in d) || isValidPollLease(d.mystarsPollLease)) &&
        (!('buyerNotificationState' in d) || isValidNotificationState(d.buyerNotificationState)) &&
        (!('adminNotificationState' in d) || isValidNotificationState(d.adminNotificationState)) &&
        isDate(d.get('mystarsExpiresAt', ts)) &&
        isDate(d.get('mystarsLastPolledAt', ts)) &&
        isDate(d.get('mystarsStuckAlertedAt', ts)) &&
        isDate(d.get('mystarsAmbiguousPostAt', ts)) &&
        isDate(d.get('fulfillmentStartedAt', ts)) &&
        isDate(d.get('fulfillmentNextRetryAt', ts)) &&
        isDate(d.get('refundStartedAt', ts)) &&
        isDate(d.get('adminNotifiedAt', ts)) &&
        isDate(d.get('buyerNotifiedAt', ts)) &&
        isDate(d.get('paidAt', ts)) &&
        isDate(d.get('completedAt', ts));
    }

    function isValidOrder(d, orderId, ts) {
      return d.orderId == orderId &&
        d.keys().hasOnly([
          'orderId',
          'userId',
          'userTelegramId',
          'username',
          'recipientUsername',
          'productId',
          'productName',
          'category',
          'quantity',
          'durationMonths',
          'unitPriceUsdCents',
          'totalPriceUsdCents',
          'totalPrice',
          'currency',
          'paymentMethod',
          'activePaymentId',
          'externalInvoiceId',
          'balancePaymentId',
          'balanceRefunded',
          'paymentStatus',
          'fulfillmentStatus',
          'telegramPaymentChargeId',
          'providerPaymentChargeId',
          'fulfillmentProvider',
          'grossRevenueUsdCents',
          'providerFeeUsdCents',
          'mystarsCurrency',
          'mystarsWholesaleCostUsdt',
          'mystarsCostUsdCents',
          'tonNetworkFeeTon',
          'tonNetworkFeeUsdCents',
          'netProfitUsdCents',
          'mystarsOrderId',
          'mystarsOrderStatus',
          'mystarsPayToAddress',
          'mystarsPaymentMemo',
          'mystarsPaymentAmountUsdt',
          'mystarsPurchaseTx',
          'mystarsPaymentTx',
          'mystarsReversalTx',
          'mystarsFailureReason',
          'mystarsExpiresAt',
          'mystarsLastPolledAt',
          'mystarsPollAttempts',
          'mystarsLastPollError',
          'mystarsPollLease',
          'mystarsStuckAlertedAt',
          'mystarsUnknownStatusSeen',
          'mystarsCreateInFlight',
          'mystarsAmbiguousPostAt',
          'fulfillmentNote',
          'fulfillmentStartedAt',
          'fulfillmentAttempts',
          'fulfillmentLastError',
          'fulfillmentNextRetryAt',
          'fulfillmentIdempotencyKey',
          'externalExecutionReference',
          'needsManualReconciliation',
          'assignedKeyIds',
          'deliveredKeyValues',
          'awaitingKeyStock',
          'refundState',
          'refundLockToken',
          'refundStartedAt',
          'refundLastError',
          'refundStatsAdjusted',
          'adminNotifiedAt',
          'buyerNotifiedAt',
          'buyerNotificationState',
          'adminNotificationState',
          'createdAt',
          'paidAt',
          'completedAt',
          'completedByAdminId',
          'updatedAt'
        ]) &&
        isValidOrderStrings(d) &&
        isValidOrderNumbersAndDates(d, ts);
    }

    function isOrderAdminCreate(d, orderId, ts) {
      return isFreshTs(d.createdAt) &&
        isFreshTs(d.updatedAt) &&
        isValidOrder(d, orderId, ts);
    }

    function isOrderAdminUpdate(d, prev, orderId, ts) {
      return isFreshTs(d.updatedAt) &&
        !d.diff(prev).affectedKeys().hasAny([
          'orderId', 'userId', 'userTelegramId', 'productId',
          'quantity', 'totalPrice', 'currency', 'createdAt'
        ]) &&
        isValidOrder(d, orderId, ts);
    }

    function isOrderBuyerCreate(d, orderId) {
      return isOwner(d.userId) &&
        isFreshTs(d.createdAt) &&
        isFreshTs(d.updatedAt) &&
        isValidBuyerOrderCreate(d, orderId) &&
        exists(/databases/$(database)/documents/users/$(d.userId)) &&
        get(/databases/$(database)/documents/users/$(d.userId)).data.isBlocked == false &&
        exists(/databases/$(database)/documents/products/$(d.productId)) &&
        isBuyerProductValid(get(/databases/$(database)/documents/products/$(d.productId)).data, d);
    }

    function isOrderBuyerCancel(d, prev, orderId) {
      return isValidId(orderId) &&
        isOwner(prev.userId) &&
        isFreshTs(d.updatedAt) &&
        prev.paymentStatus == 'pending' &&
        prev.fulfillmentStatus == 'pending' &&
        d.paymentStatus == 'cancelled' &&
        d.fulfillmentStatus == 'cancelled' &&
        d.diff(prev).affectedKeys().hasOnly(['paymentStatus', 'fulfillmentStatus', 'updatedAt']);
    }

    // Payment Validator (100% strict field validation under CEL budget)
    function isValidPayment(d, paymentId) {
      return d.keys().hasAll(['paymentId', 'orderId', 'userId', 'userTelegramId', 'totalAmount', 'currency', 'invoicePayload', 'status', 'createdAt']) &&
        d.keys().hasOnly([
          'paymentId',
          'kind',
          'provider',
          'providerPaymentId',
          'telegramPaymentChargeId',
          'providerPaymentChargeId',
          'orderId',
          'topUpId',
          'userId',
          'userTelegramId',
          'totalAmount',
          'expectedUsdCents',
          'feeUsdCents',
          'netUsdCents',
          'expectedAmountStr',
          'actualAmountStr',
          'verifiedAmountStr',
          'verifiedCurrency',
          'verifiedNetwork',
          'exchangeRateUsdStr',
          'currency',
          'network',
          'invoicePayload',
          'payUrl',
          'status',
          'statusReason',
          'failureReason',
          'needsManualReconciliation',
          'refundRequired',
          'reconciliationState',
          'reconciliationReason',
          'conflictingOrderStatus',
          'conflictingFulfillmentStatus',
          'supersededByPaymentId',
          'expiresAt',
          'paidAt',
          'confirmedAt',
          'createdAt',
          'updatedAt',
          'refundedAt'
        ]) &&
        d.paymentId == paymentId && d.paymentId.matches('^[a-zA-Z0-9_\\-]{1,128}$') &&
        d.get('kind', 'order') in ['order', 'topup'] &&
        d.get('provider', 'cryptobot') in ['cryptobot', 'xrocket', 'balance', 'telegram_stars'] &&
        d.get('providerPaymentId', 'a').matches('^.{1,128}$') &&
        d.get('telegramPaymentChargeId', 'a').matches('^.{1,128}$') &&
        d.get('providerPaymentChargeId', '').matches('^.{0,128}$') &&
        d.orderId.matches('^[a-zA-Z0-9_\\-]{1,64}$') &&
        d.get('topUpId', 'a').matches('^[a-zA-Z0-9_\\-]{1,64}$') &&
        d.userId.matches('^[a-zA-Z0-9_\\-]{1,64}$') &&
        d.userTelegramId is int && d.userTelegramId > 0 &&
        d.totalAmount is number && d.totalAmount > 0 && d.totalAmount <= 100000000 &&
        isIntRange(d.get('expectedUsdCents', 0), 0, 100000000) &&
        isIntRange(d.get('feeUsdCents', 0), 0, 100000000) &&
        isIntRange(d.get('netUsdCents', 0), 0, 100000000) &&
        d.get('expectedAmountStr', '1').matches('^(0\\.[0-9]{0,17}[1-9][0-9]{0,17}|[1-9][0-9]{0,44}(\\.[0-9]{1,18})?)$') &&
        d.get('actualAmountStr', '0').matches('^[0-9]{1,45}(\\.[0-9]{1,18})?$') &&
        d.get('verifiedAmountStr', '0').matches('^[0-9]{1,45}(\\.[0-9]{1,18})?$') &&
        d.get('verifiedCurrency', 'USD').matches('^.{1,16}$') &&
        d.get('verifiedNetwork', 'TON').matches('^.{1,32}$') &&
        d.get('exchangeRateUsdStr', '1').matches('^(0\\.[0-9]{0,17}[1-9][0-9]{0,17}|[1-9][0-9]{0,44}(\\.[0-9]{1,18})?)$') &&
        d.currency.matches('^.{1,16}$') &&
        d.get('network', 'TON').matches('^.{1,32}$') &&
        d.invoicePayload.matches('^.{1,256}$') &&
        d.get('payUrl', 'https://t.me').matches('^https?://.{1,504}$') &&
        d.status in ['pending', 'paid', 'underpaid', 'overpaid', 'expired', 'cancelled', 'failed', 'refunded', 'refund_required'] &&
        d.get('statusReason', '').matches('(?s)^.{0,500}$') &&
        d.get('failureReason', '').matches('(?s)^.{0,500}$') &&
        d.get('needsManualReconciliation', false) is bool &&
        d.get('refundRequired', false) is bool &&
        d.get('reconciliationState', 'resolved') in ['refund_required', 'manual_reconciliation', 'resolved'] &&
        d.get('reconciliationReason', 'a').matches('^.{1,128}$') &&
        d.get('conflictingOrderStatus', 'pending') in ['pending', 'paid', 'processing', 'completed', 'cancelled', 'refunded', 'failed'] &&
        d.get('conflictingFulfillmentStatus', 'pending') in ['pending', 'paid', 'processing', 'completed', 'cancelled', 'refunded', 'failed'] &&
        d.get('supersededByPaymentId', 'a').matches('^.{1,128}$') &&
        isDate(d.get('expiresAt', request.time)) &&
        isDate(d.get('paidAt', request.time)) &&
        isDate(d.get('confirmedAt', request.time)) &&
        isDate(d.createdAt) &&
        isDate(d.get('updatedAt', request.time)) &&
        isDate(d.get('refundedAt', request.time));
    }

    function isValidBalanceTopUp(d, paymentId) {
      return d.keys().hasAll([
          'paymentId',
          'userId',
          'userTelegramId',
          'provider',
          'amountUsdCents',
          'feeUsdCents',
          'amountCreditedUsdCents',
          'expectedAmountStr',
          'currency',
          'paymentStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        d.keys().hasOnly([
          'paymentId',
          'userId',
          'userTelegramId',
          'username',
          'provider',
          'providerPaymentId',
          'amountUsdCents',
          'feeUsdCents',
          'amountCreditedUsdCents',
          'expectedUsdCents',
          'feeBps',
          'feePercent',
          'expectedAmountStr',
          'actualAmountStr',
          'verifiedAmountStr',
          'verifiedCurrency',
          'verifiedNetwork',
          'amountUsd',
          'amountPaid',
          'feeAmount',
          'amountCredited',
          'currency',
          'originalCurrency',
          'originalAmountPaid',
          'exchangeRateUsdStr',
          'exchangeRateUsd',
          'network',
          'paymentStatus',
          'statusReason',
          'externalInvoiceId',
          'payUrl',
          'recipientMerchantId',
          'failureReason',
          'needsManualReconciliation',
          'refundRequired',
          'reconciliationState',
          'reconciliationReason',
          'expiresAt',
          'createdAt',
          'paidAt',
          'confirmedAt',
          'updatedAt'
        ]) &&
        d.paymentId == paymentId && d.paymentId.matches('^[a-zA-Z0-9_\\-]{1,128}$') &&
        d.userId.matches('^[a-zA-Z0-9_\\-]{1,64}$') &&
        d.userTelegramId is int && d.userTelegramId > 0 &&
        d.get('username', '').matches('^.{0,64}$') &&
        d.provider in ['cryptobot', 'xrocket'] &&
        d.get('providerPaymentId', 'a').matches('^.{1,128}$') &&
        isIntRange(d.amountUsdCents, 1, 100000000) &&
        isIntRange(d.feeUsdCents, 0, 100000000) &&
        isIntRange(d.amountCreditedUsdCents, 0, 100000000) &&
        isIntRange(d.get('expectedUsdCents', 0), 0, 100000000) &&
        isIntRange(d.get('feeBps', 0), 0, 10000) &&
        d.get('feePercent', 0) is number && d.get('feePercent', 0) >= 0 && d.get('feePercent', 0) <= 100 &&
        d.expectedAmountStr.matches('^(0\\.[0-9]{0,17}[1-9][0-9]{0,17}|[1-9][0-9]{0,44}(\\.[0-9]{1,18})?)$') &&
        d.get('actualAmountStr', '0').matches('^[0-9]{1,45}(\\.[0-9]{1,18})?$') &&
        d.get('verifiedAmountStr', '0').matches('^[0-9]{1,45}(\\.[0-9]{1,18})?$') &&
        d.get('verifiedCurrency', 'USD').matches('^.{1,16}$') &&
        d.get('verifiedNetwork', 'TON').matches('^.{1,32}$') &&
        d.get('amountUsd', 0) is number && d.get('amountUsd', 0) >= 0 &&
        d.get('amountPaid', 0) is number && d.get('amountPaid', 0) >= 0 &&
        d.get('feeAmount', 0) is number && d.get('feeAmount', 0) >= 0 &&
        d.get('amountCredited', 0) is number && d.get('amountCredited', 0) >= 0 &&
        d.currency.matches('^.{1,16}$') &&
        d.get('originalCurrency', 'USD').matches('^.{1,16}$') &&
        d.get('originalAmountPaid', 0) is number && d.get('originalAmountPaid', 0) >= 0 &&
        d.get('exchangeRateUsdStr', '1').matches('^(0\\.[0-9]{0,17}[1-9][0-9]{0,17}|[1-9][0-9]{0,44}(\\.[0-9]{1,18})?)$') &&
        d.get('exchangeRateUsd', 1) is number && d.get('exchangeRateUsd', 1) > 0 &&
        d.get('network', 'TON').matches('^.{1,32}$') &&
        d.paymentStatus in ['pending', 'paid', 'underpaid', 'overpaid', 'expired', 'cancelled', 'failed', 'refunded', 'refund_required'] &&
        d.get('statusReason', '').matches('(?s)^.{0,500}$') &&
        d.get('externalInvoiceId', 'a').matches('^.{1,128}$') &&
        d.get('payUrl', 'https://t.me').matches('^https?://.{1,504}$') &&
        d.get('recipientMerchantId', 'a').matches('^.{1,128}$') &&
        d.get('failureReason', '').matches('(?s)^.{0,500}$') &&
        d.get('needsManualReconciliation', false) is bool &&
        d.get('refundRequired', false) is bool &&
        d.get('reconciliationState', 'resolved') in ['refund_required', 'manual_reconciliation', 'resolved'] &&
        d.get('reconciliationReason', 'a').matches('^.{1,128}$') &&
        isDate(d.get('expiresAt', request.time)) &&
        isDate(d.createdAt) &&
        isDate(d.get('paidAt', request.time)) &&
        isDate(d.get('confirmedAt', request.time)) &&
        isDate(d.updatedAt);
    }

    function isValidTransaction(d, transactionId) {
      return d.keys().hasAll(['transactionId', 'orderId', 'userId', 'type', 'amount', 'currency', 'details', 'createdAt']) &&
        d.keys().hasOnly([
          'transactionId',
          'orderId',
          'userId',
          'paymentId',
          'supersededByPaymentId',
          'provider',
          'externalInvoiceId',
          'verifiedAmountStr',
          'verifiedCurrency',
          'network',
          'reconciliationReason',
          'confirmedAt',
          'type',
          'amount',
          'amountUsdCents',
          'currency',
          'details',
          'createdAt'
        ]) &&
        d.transactionId == transactionId && d.transactionId.matches('^[a-zA-Z0-9_\\-]{1,64}$') &&
        d.orderId.matches('^[a-zA-Z0-9_\\-]{1,64}$') &&
        d.userId.matches('^[a-zA-Z0-9_\\-]{1,64}$') &&
        d.get('paymentId', 'a').matches('^.{1,128}$') &&
        d.get('supersededByPaymentId', 'a').matches('^.{1,128}$') &&
        d.get('provider', 'cryptobot') in ['cryptobot', 'xrocket', 'balance', 'telegram_stars'] &&
        d.get('externalInvoiceId', 'a').matches('^.{1,128}$') &&
        d.get('verifiedAmountStr', '0').matches('^[0-9]{1,45}(\\.[0-9]{1,18})?$') &&
        d.get('verifiedCurrency', 'USD').matches('^.{1,16}$') &&
        d.get('network', 'TON').matches('^.{1,32}$') &&
        d.get('reconciliationReason', 'a').matches('^.{1,128}$') &&
        isDate(d.get('confirmedAt', request.time)) &&
        d.type in [
          'invoice_created',
          'pre_checkout_ok',
          'payment_received',
          'order_underpaid',
          'order_overpaid',
          'order_expired',
          'fulfillment_completed',
          'fulfillment_failed',
          'fulfillment_retry',
          'order_cancelled',
          'payment_refunded',
          'payment_refund_required',
          'balance_topup_created',
          'balance_topup_paid',
          'balance_topup_underpaid',
          'balance_topup_overpaid',
          'balance_topup_failed',
          'balance_topup_expired',
          'balance_deducted',
          'balance_refunded',
          'exchange_rate_locked',
          'key_added',
          'key_generated',
          'key_delivered',
          'key_disabled',
          'key_stock_empty',
          'admin_action',
          'error'
        ] &&
        d.amount is number && d.amount >= 0 && d.amount <= 100000000 &&
        isIntRange(d.get('amountUsdCents', 0), 0, 100000000) &&
        d.currency.matches('^.{1,16}$') &&
        d.details.matches('(?s)^.{1,500}$') &&
        isDate(d.createdAt);
    }

    function isValidAdmin(d, adminId) {
      return d.keys().hasAll(['adminId', 'telegramId', 'role', 'addedAt']) &&
        d.keys().hasOnly(['adminId', 'telegramId', 'role', 'addedAt']) &&
        d.adminId == adminId && d.adminId.matches('^[a-zA-Z0-9_\\-]{1,64}$') &&
        d.telegramId is int && d.telegramId > 0 &&
        d.role in ['admin', 'superadmin'] &&
        isDate(d.addedAt);
    }

    function isValidSetting(d, settingKey) {
      return d.keys().hasAll(['key', 'storeName', 'supportUsername', 'maintenanceMode', 'updatedAt']) &&
        d.keys().hasOnly(['key', 'storeName', 'supportUsername', 'maintenanceMode', 'updatedAt']) &&
        d.key == settingKey && d.key.matches('^[a-zA-Z0-9_\\-]{1,64}$') &&
        d.storeName.matches('^.{1,120}$') &&
        d.supportUsername.matches('^.{1,64}$') &&
        d.maintenanceMode is bool &&
        isDate(d.updatedAt);
    }

    // 1. /users/{userId}
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isValidUser(incoming(), userId) &&
        isFreshTs(incoming().createdAt) &&
        isFreshTs(incoming().updatedAt) && (
          isAdmin() ||
          (isOwner(userId) &&
            incoming().isBlocked == false &&
            incoming().totalOrders == 0 &&
            incoming().totalSpentStars == 0 &&
            incoming().get('balanceUsdCents', 0) == 0 &&
            incoming().get('totalSpentUsdCents', 0) == 0 &&
            incoming().get('balance', 0) == 0)
        );
      allow update: if isValidId(userId) && isValidUser(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().telegramId == existing().telegramId &&
        incoming().createdAt == existing().createdAt &&
        isFreshTs(incoming().updatedAt) && (
          isAdmin() ||
          (isOwner(userId) &&
            existing().isBlocked == false &&
            incoming().isBlocked == false &&
            incoming().totalOrders == existing().totalOrders &&
            incoming().totalSpentStars == existing().totalSpentStars &&
            (!('balanceUsdCents' in existing()) || incoming().balanceUsdCents == existing().balanceUsdCents) &&
            (!('totalSpentUsdCents' in existing()) || incoming().totalSpentUsdCents == existing().totalSpentUsdCents) &&
            (!('balance' in existing()) || incoming().balance == existing().balance) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['username', 'firstName', 'lastName', 'languageCode', 'updatedAt']))
        );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // 2. /products/{productId}
    match /products/{productId} {
      allow get: if isValidId(productId) && (existing().isActive == true || isAdmin());
      allow list: if existing().isActive == true || isAdmin();
      allow create: if isValidId(productId) && isValidProduct(incoming(), productId) &&
        isFreshTs(incoming().createdAt) &&
        isFreshTs(incoming().updatedAt) &&
        isAdmin();
      allow update: if isValidId(productId) && isValidProduct(incoming(), productId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        isFreshTs(incoming().updatedAt) &&
        isAdmin();
      allow delete: if isValidId(productId) && isAdmin();
    }

    // 3. /orders/{orderId}
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isOwner(existing().userId) || isAdmin());
      allow list: if (isVerified() && existing().userId == request.auth.uid) || isAdmin();
      allow create: if (isAdmin() && isOrderAdminCreate(request.resource.data, orderId, request.time)) ||
        isOrderBuyerCreate(request.resource.data, orderId);
      allow update: if (isAdmin() && isOrderAdminUpdate(request.resource.data, resource.data, orderId, request.time)) ||
        isOrderBuyerCancel(request.resource.data, resource.data, orderId);
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // 4. /payments/{paymentId}
    match /payments/{paymentId} {
      allow get: if isValidId(paymentId) && (isOwner(existing().userId) || isAdmin());
      allow list: if (isVerified() && existing().userId == request.auth.uid) || isAdmin();
      allow create: if isValidId(paymentId) && isValidPayment(incoming(), paymentId) &&
        isFreshTs(incoming().createdAt) &&
        isAdmin() &&
        exists(/databases/$(database)/documents/orders/$(incoming().orderId));
      allow update: if isValidId(paymentId) && isValidPayment(incoming(), paymentId) &&
        incoming().paymentId == existing().paymentId &&
        incoming().orderId == existing().orderId &&
        incoming().userId == existing().userId &&
        incoming().userTelegramId == existing().userTelegramId &&
        incoming().totalAmount == existing().totalAmount &&
        incoming().currency == existing().currency &&
        incoming().createdAt == existing().createdAt &&
        (!('providerPaymentId' in existing()) || incoming().providerPaymentId == existing().providerPaymentId) &&
        (!('telegramPaymentChargeId' in existing()) || incoming().telegramPaymentChargeId == existing().telegramPaymentChargeId) &&
        isAdmin();
      allow delete: if false;
    }

    // 4b. /balance_topups/{paymentId}
    match /balance_topups/{paymentId} {
      allow get: if isValidId(paymentId) && (isOwner(existing().userId) || isAdmin());
      allow list: if (isVerified() && existing().userId == request.auth.uid) || isAdmin();
      allow create: if isValidId(paymentId) && isValidBalanceTopUp(incoming(), paymentId) &&
        isFreshTs(incoming().createdAt) &&
        isFreshTs(incoming().updatedAt) &&
        isAdmin();
      allow update: if isValidId(paymentId) && isValidBalanceTopUp(incoming(), paymentId) &&
        incoming().paymentId == existing().paymentId &&
        incoming().userId == existing().userId &&
        incoming().userTelegramId == existing().userTelegramId &&
        incoming().createdAt == existing().createdAt &&
        isFreshTs(incoming().updatedAt) &&
        isAdmin();
      allow delete: if false;
    }

    // 4c. /digital_keys/{keyId} — Strictly backend/owner only; never accessible via client SDK
    match /digital_keys/{keyId} {
      allow read, write: if false;
    }

    // 4d. /payment_locks/{lockId} — Strictly backend transaction claim lock; never accessible via client SDK
    match /payment_locks/{lockId} {
      allow read, write: if false;
    }

    // 5. /transactions/{transactionId}
    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(transactionId) && isValidTransaction(incoming(), transactionId) &&
        isFreshTs(incoming().createdAt) &&
        isAdmin();
      allow update, delete: if false;
    }

    // 6. /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminId) && isValidAdmin(incoming(), adminId) &&
        isFreshTs(incoming().addedAt) &&
        isAdmin();
      allow update: if isValidId(adminId) && isValidAdmin(incoming(), adminId) &&
        incoming().adminId == existing().adminId &&
        incoming().addedAt == existing().addedAt &&
        isAdmin();
      allow delete: if isValidId(adminId) && isAdmin();
    }

    // 7. /settings/{settingKey}
    match /settings/{settingKey} {
      allow get: if isValidId(settingKey) && (isAdmin() || (isSignedIn() && settingKey == 'global'));
      allow list: if isAdmin();
      allow create: if isValidId(settingKey) && isValidSetting(incoming(), settingKey) &&
        isFreshTs(incoming().updatedAt) &&
        isAdmin();
      allow update: if isValidId(settingKey) && isValidSetting(incoming(), settingKey) &&
        incoming().key == existing().key &&
        isFreshTs(incoming().updatedAt) &&
        isAdmin();
      allow delete: if isValidId(settingKey) && isAdmin();
    }
  }
}
